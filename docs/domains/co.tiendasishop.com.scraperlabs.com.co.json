{
  "domainId": "co.tiendasishop.com",
  "providerId": "scraperlabsapi",
  "countryCode": "CO",
  "enabled": true,
  "typeService": [
    "scraping"
  ],
  "supportedTypes": [
    "detail",
    "search",
    "searchSpecific"
  ],
  "providerConfig": {
    "detail": {
      "wait": 2000,
      "block_images": true,
      "timeout": 45000
    },
    "search": {
      "wait": 2500,
      "block_images": true,
      "timeout": 45000
    },
    "searchSpecific": {
      "wait": 2500,
      "block_images": true,
      "timeout": 45000
    }
  },
  "scraperConfig": {
    "search": {
      "containerSelector": ".product-card, .product-item, .grid-product, li.grid__item, .card-wrapper",
      "titleSelector": ".product-card__title, .product-item__title, .card__heading, a.full-unstyled-link, h3",
      "priceSelector": ".price-item--sale, .price-item--regular, .price, .money",
      "originalPriceSelector": "s.price-item--regular, .price__sale s, .compare-at-price",
      "urlSelector": "a.product-card__link, a[href*='/products/']",
      "imageSelector": "img",
      "scripts": []
    },
    "searchSpecific": {
      "css": {
        "title": ".product-card__title, .product-item__title, .card__heading, a.full-unstyled-link, h3",
        "price": ".price-item--sale, .price-item--regular, .price, .money",
        "originalPrice": "s.price-item--regular, .price__sale s, .compare-at-price",
        "url": "a.product-card__link, a[href*='/products/']",
        "image": "img",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "pricePath": "offers.price",
        "originalPricePath": "offers.highPrice"
      },
      "scripts": []
    },
    "detail": {
      "css": {
        "title": "h1.product-title, h1.product__title, h1.product-meta__title, h1",
        "price": ".price .price-item--sale, .price .price-item--regular, .product-price, .price .money, span.price",
        "originalPrice": "s.price-item--regular, .price-item--regular, .product-price--compare, span.compare-at-price",
        "image": ".product__media img, .product-gallery img, .product-single__media img, img[src*='/products/']",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "titlePath": "name",
        "imagePath": "image[0]",
        "pricePath": "offers.price",
        "originalPricePath": "offers.highPrice"
      },
      "scripts": [
        {
          "key": "currentPrice",
          "regex": "[\"']?price[\"']?\\s*:\\s*[\"']?(\\d+)[\"']?",
          "divisor": 100
        },
        {
          "key": "originalPrice",
          "regex": "[\"']?compare_at_price[\"']?\\s*:\\s*[\"']?(\\d+)[\"']?",
          "divisor": 100
        },
        {
          "key": "title",
          "regex": "[\"']?product_name[\"']?\\s*:\\s*[\"']([^\"']+)[\"']"
        }
      ]
    }
  },
  "strategyOrder": [
    "scripts",
    "jsonLd",
    "css",
    "meta"
  ],
  "useJsonLd": true,
  "useCss": true,
  "useScripts": true,
  "useMeta": true,
  "useNextData": false,
  "subdomains": [
    "ishop.com.co",
    "tiendasishop.com"
  ]
}
