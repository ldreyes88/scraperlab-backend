{
  "domainId": "tienda.movistar.com.co",
  "providerId": "scraperlabsapi",
  "countryCode": "CO",
  "enabled": true,
  "typeService": [
    "scraping"
  ],
  "supportedTypes": [
    "detail",
    "search",
    "searchSpecific"
  ],
  "providerConfig": {
    "detail": {
      "wait": 2500,
      "block_images": true,
      "timeout": 45000
    },
    "search": {
      "wait": 3000,
      "block_images": true,
      "timeout": 45000
    },
    "searchSpecific": {
      "wait": 3000,
      "block_images": true,
      "timeout": 45000
    }
  },
  "scraperConfig": {
    "search": {
      "containerSelector": "li.product-item, .product-item-info, .item.product",
      "titleSelector": ".product-item-name a, .product-item-link, strong.product-name a, h2.product-name a",
      "priceSelector": ".price-box .price, [data-price-type='finalPrice'] .price, span.price",
      "originalPriceSelector": ".old-price .price, [data-price-type='oldPrice'] .price",
      "urlSelector": "a.product-item-link, a.product-item-photo",
      "imageSelector": "img.product-image-photo, img.product-image",
      "scripts": []
    },
    "searchSpecific": {
      "css": {
        "title": ".product-item-name a, .product-item-link, strong.product-name a, h2.product-name a",
        "price": ".price-box .price, [data-price-type='finalPrice'] .price, span.price",
        "originalPrice": ".old-price .price, [data-price-type='oldPrice'] .price",
        "url": "a.product-item-link, a.product-item-photo",
        "image": "img.product-image-photo, img.product-image",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "pricePath": "offers.price",
        "originalPricePath": "offers.highPrice"
      },
      "scripts": []
    },
    "detail": {
      "css": {
        "title": "h1.page-title span, h1.page-title, h1[itemprop='name'], h1",
        "price": ".price-box .price-container .price, [data-price-type='finalPrice'] .price, .product-info-price .price, span.price",
        "originalPrice": ".old-price .price, [data-price-type='oldPrice'] .price, .price-box .old-price .price",
        "image": ".fotorama__stage__frame img, .gallery-placeholder img, img.gallery-image, img[itemprop='image']",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "titlePath": "name",
        "imagePath": "image[0]",
        "pricePath": "offers.price",
        "originalPricePath": "offers.highPrice"
      },
      "scripts": [
        {
          "key": "currentPrice",
          "regex": "[\"']?finalPrice[\"']?\\s*:\\s*[\"']?(\\d+)[\"']?"
        },
        {
          "key": "originalPrice",
          "regex": "[\"']?oldPrice[\"']?\\s*:\\s*[\"']?(\\d+)[\"']?"
        }
      ]
    }
  },
  "strategyOrder": [
    "css",
    "jsonLd",
    "meta",
    "scripts"
  ],
  "useJsonLd": true,
  "useCss": true,
  "useScripts": false,
  "useMeta": true,
  "useNextData": false,
  "subdomains": []
}
