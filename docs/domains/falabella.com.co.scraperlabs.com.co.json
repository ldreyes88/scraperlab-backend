{
  "domainId": "falabella.com.co",
  "providerId": "scraperlabsapi",
  "countryCode": "CO",
  "enabled": true,
  "supportedTypes": [
    "detail",
    "search",
    "searchSpecific"
  ],
  "providerConfig": {
    "detail": {
      "wait": 2000,
      "block_images": true,
      "timeout": 45000
    },
    "search": {
      "wait": 3000,
      "wait_for_selector": ".grid-pod",
      "block_images": true,
      "timeout": 45000
    },
    "searchSpecific": {
      "wait": 3000,
      "wait_for_selector": ".grid-pod",
      "block_images": true,
      "timeout": 45000
    }
  },
  "scraperConfig": {
    "search": {
      "containerSelector": ".grid-pod",
      "titleSelector": ".pod-subTitle, [id^='testId-pod-displaySubTitle-'], [id^='testId-pod-display-name']",
      "priceSelector": "li.prices-0 span[class*='copy'], [data-internet-price]",
      "originalPriceSelector": "li.prices-2 span, span.crossed, li.prices-1 span",
      "urlSelector": "a[href*='/product/'], a.pod-link",
      "imageSelector": "img",
      "scripts": []
    },
    "searchSpecific": {
      "css": {
        "title": ".pod-subTitle, [id^='testId-pod-displaySubTitle-'], [id^='testId-pod-display-name']",
        "price": "li.prices-0 span[class*='copy'], [data-internet-price]",
        "originalPrice": "li.prices-2 span, span.crossed, li.prices-1 span",
        "url": "a[href*='/product/'], a.pod-link",
        "image": "img",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "pricePath": "",
        "originalPricePath": ""
      },
      "scripts": []
    },
    "detail": {
      "css": {
        "title": "h1[class*='product-name']",
        "price": "li.prices-0, [class*='prices-0']",
        "originalPrice": "li.prices-1, [class*='prices-1']",
        "image": "img[src*='falabellaCO']",
        "availability": ""
      },
      "nextData": {
        "productPath": "",
        "pricePath": "",
        "originalPricePath": "",
        "titlePath": "",
        "imagePath": ""
      },
      "jsonLd": {
        "titlePath": "name",
        "imagePath": "image[0]",
        "pricePath": "price"
      },
      "scripts": []
    }
  },
  "strategyOrder": [
    "css",
    "jsonLd",
    "meta"
  ],
  "useJsonLd": true,
  "useCss": true,
  "useMeta": true,
  "useNextData": false,
  "useScripts": false,
  "subdomains": []
}
